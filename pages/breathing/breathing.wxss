.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 72rpx 48rpx 48rpx;
  box-sizing: border-box;
}

.circle-wrap {
  margin-top: 48rpx;
  height: 520rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.halo {
  width: 380rpx;
  height: 380rpx;
  border-radius: 50%;
  background: radial-gradient(circle, #33513a 0%, #22392a 62%, rgba(34, 57, 42, 0) 72%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.core {
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background-color: #16211b;
  border: 1rpx solid #2c3a32;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.phase { font-size: 56rpx; color: #eef4ee; font-weight: 300; }

.count { margin-top: 8rpx; font-size: 34rpx; color: #8fa895; }

.status { margin-top: 24rpx; font-size: 28rpx; color: #8fa895; }

.cycles { margin-top: 10rpx; font-size: 26rpx; color: #5f7263; }

.section { width: 100%; margin-top: 52rpx; }

.label { font-size: 26rpx; color: #8fa895; margin-bottom: 20rpx; }

.chips { display: flex; flex-wrap: wrap; gap: 18rpx; }

.chip {
  min-width: 96rpx;
  padding: 16rpx 22rpx;
  text-align: center;
  font-size: 28rpx;
  color: #cfdccf;
  background-color: #1b2620;
  border: 1rpx solid #2c3a32;
  border-radius: 999rpx;
}

.chip-on {
  background-color: #33513a;
  border-color: #7fa877;
  color: #ffffff;
}

.controls {
  width: 100%;
  margin-top: 64rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.btn {
  width: 100%;
  padding: 10rpx 0;
  font-size: 32rpx;
  color: #e8efe9;
  background-color: #1b2620;
  border: 1rpx solid #2c3a32;
  border-radius: 999rpx;
}

.btn.primary {
  background-color: #3c6a46;
  border-color: #7fa877;
  color: #ffffff;
}

.btn.ghost { background-color: transparent; color: #8fa895; }

.hint {
  margin-top: 48rpx;
  font-size: 24rpx;
  color: #5f7263;
  text-align: center;
}
